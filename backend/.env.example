# ============================================
# MentorAI Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# REQUIRED: Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# REQUIRED: JWT Secret for authentication
# Generate a random string for production
JWT_SECRET=your_jwt_secret_here

# Database Configuration
DATABASE_PATH=data/mentorai.db

# Flask Configuration
DEBUG=True
SECRET_KEY=dev-secret-key

# ============================================
# OPTIONAL: Voice Features
# Only needed if you want voice chat functionality
# ============================================

# OpenAI API Key (for Whisper speech-to-text)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Credentials (for Text-to-Speech)
# Download JSON key file and set path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json

# Feature Flags
VOICE_ENABLED=False          # Set to True if you have API keys above
FILE_UPLOAD_ENABLED=True     # Set to False to disable file uploads

# Token Configuration
TOKEN_EXPIRATION_HOURS=24    # JWT token expiration time
