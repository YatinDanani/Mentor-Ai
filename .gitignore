.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
*.tmp
temp/
tmp/

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Production
.vercel

# Cache
.cache/
.npm/

